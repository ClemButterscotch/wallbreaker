{
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "rules.html", "use": "@vercel/static" },
    { "src": "preview.html", "use": "@vercel/static" },
    { "src": "public/app.js", "use": "@vercel/static" },
    { "src": "public/brand.js", "use": "@vercel/static" },
    { "src": "public/icons.js", "use": "@vercel/static" },
    { "src": "public/preview.js", "use": "@vercel/static" },
    { "src": "public/preview.css", "use": "@vercel/static" },
    { "src": "public/game-rules.js", "use": "@vercel/static" },
    { "src": "public/tutorial.js", "use": "@vercel/static" },
    { "src": "public/rules.js", "use": "@vercel/static" },
    { "src": "public/rules.css", "use": "@vercel/static" },
    { "src": "public/styles.css", "use": "@vercel/static" },
    { "src": "public/logo.svg", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/rules", "dest": "/rules.html" },
    { "src": "/preview", "dest": "/preview.html" },
    { "src": "/host", "dest": "/index.html" },
    { "src": "/tutorial/host", "dest": "/index.html" },
    { "src": "/app.js", "dest": "/public/app.js" },
    { "src": "/brand.js", "dest": "/public/brand.js" },
    { "src": "/icons.js", "dest": "/public/icons.js" },
    { "src": "/preview.js", "dest": "/public/preview.js" },
    { "src": "/preview.css", "dest": "/public/preview.css" },
    { "src": "/game-rules.js", "dest": "/public/game-rules.js" },
    { "src": "/tutorial.js", "dest": "/public/tutorial.js" },
    { "src": "/rules.js", "dest": "/public/rules.js" },
    { "src": "/rules.css", "dest": "/public/rules.css" },
    { "src": "/styles.css", "dest": "/public/styles.css" },
    { "src": "/logo.svg", "dest": "/public/logo.svg" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
